    ROLES {
        smallint id_rol PK
        varchar codigo UK
        varchar nombre
    }
    PERMISOS {
        smallint id_permiso PK
        varchar codigo UK
        varchar descripcion
    }
    ROL_PERMISO {
        smallint id_rol PK, FK
        smallint id_permiso PK, FK
    }
    USUARIOS {
        integer id_usuario PK
        varchar username UK
        varchar password_hash
        smallint id_rol FK
        boolean activo
    }
    PACIENTES {
        integer id_paciente PK
        integer id_usuario FK, UK
        smallint id_tipo_doc FK
        varchar num_doc
        varchar nombre1
        varchar apellido1
        numeric ingreso_mensual
        varchar estado_afiliacion
        smallint id_tarifa FK
    }
    MEDICOS {
        integer id_medico PK
        integer id_usuario FK, UK
        smallint id_tipo_doc FK
        varchar num_doc
        varchar nombre1
        varchar apellido1
        smallint id_especialidad FK
        smallint id_consultorio FK
    }
    HISTORIAL {
        integer id_historial PK
        integer id_paciente FK, UK
        text alergias
        varchar grupo_sanguineo
        text antecedentes
    }
    HORARIO {
        integer id_horario PK
        integer id_medico FK
        date fecha
        time hora_inicio
        time hora_fin
        smallint id_estado FK
    }
    CITA {
        integer id_cita PK
        integer id_paciente FK
        smallint id_servicio FK
        integer id_horario FK, UK
        smallint id_estado FK
        numeric valor_cobrado
    }
    SERVICIO {
        smallint id_servicio PK
        varchar nombre
        numeric costo_base
        smallint id_especialidad FK
    }
    RESULTADO_CONSULTA {
        integer id_resultado PK
        integer id_cita FK, UK
        integer id_medico FK
        text resultado
    }
